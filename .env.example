# Public URL used for canonical links, sitemap and Open Graph. On Vercel it falls back to the production URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form (Resend free tier). Without a custom domain Resend only delivers to the account owner's email.
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Cloudflare Turnstile (free). Leave both empty to disable the challenge (honeypot still applies).
# Test keys that always pass: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Set to 1 to log contact messages instead of sending them (used by E2E tests).
CONTACT_DRY_RUN=
